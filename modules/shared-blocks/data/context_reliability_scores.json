 "benchmark": {
  "name": "GDM-MRCR v2, 8 needles",
  "method": "Multi-round co-reference resolution: a long fictional conversation in which the user made exactly the same request 8 times (« write a poem about tapirs ») and received a different answer each time, among dozens of similar requests with other formats, topics or styles; at the end the model must reproduce the n-th of the 8 answers (e.g. the 3rd poem about tapirs), preceded by a random string. Same task at every length: only the surrounding conversation grows.",
  "metric": "mean similarity to the reference answer (0-100), not a right/wrong accuracy",
  "chance_level": 15,
  "chance_source": "Google DeepMind, eval_hub mrcr_v2 README: guessing among the needles scores about 15 % with 8 needles",
  "dataset": "https://github.com/google-deepmind/eval_hub/tree/master/eval_hub/mrcr_v2",
  "measures": "https://contextarena.ai",
  "api": "https://contextarena.ai/api/needle-summary?needles=8",
  "measured_by": "Dillon Uzar (Context Arena), third party, same harness for every model",
  "bins_note": "a bin is named by its upper bound: 8K = (4K, 8K] tokens … 1M = (512K, 1M]",
  "notes": [
   "Rule m1: for each model, the highest reasoning effort measured.",
   "Claude Opus 4.7 left out: below 3 at 128K and beyond at every effort, a failure mode rather than a result.",
   "Above 512K only Gemini has a point (the 1M prompts do not fit the other models' windows)."
  ]
 },
